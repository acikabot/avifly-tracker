# Avifly Tracker configuration. Copy to .env (deploy/install.sh does this for you)
# and adjust. Never commit .env. Values are unquoted so systemd can read the file too.

# --- Core --------------------------------------------------------------------------
AVIFLY_SECRET_KEY=change-me-to-a-long-random-string
AVIFLY_DEBUG=false
# Host names / IPs the app answers to (comma-separated)
AVIFLY_ALLOWED_HOSTS=localhost,127.0.0.1
AVIFLY_TIME_ZONE=Europe/Skopje
# Where the database, uploads, cache, e-mails and logs live (default: ./var)
# AVIFLY_DATA_DIR=/home/pi/avifly-tracker/var
# Cookie-name prefix: only for a second copy on the same host (`make run` sets dev-)
# AVIFLY_COOKIE_PREFIX=

# --- Server (gunicorn) ------------------------------------------------------------------
# Home network: 0.0.0.0:8000. Behind Cloudflare Tunnel: 127.0.0.1:8000.
AVIFLY_BIND=0.0.0.0:8000
AVIFLY_WORKERS=2

# --- Feature modules (core modules are always on) -----------------------------------------
# AVIFLY_MODULES=avifly.money,avifly.analytics,avifly.imports,avifly.docs

# --- Sign-up -----------------------------------------------------------------------------
AVIFLY_SIGNUP_OPEN=true
# none | optional | mandatory  (use mandatory once real e-mail sending is set up)
AVIFLY_EMAIL_VERIFICATION=optional

# --- E-mail (leave AVIFLY_EMAIL_HOST empty to write e-mails to var/mail/) -------------------
# Gmail: smtp.gmail.com, port 587, your address, and an app password.
AVIFLY_EMAIL_HOST=
AVIFLY_EMAIL_PORT=587
AVIFLY_EMAIL_HOST_USER=
AVIFLY_EMAIL_HOST_PASSWORD=
AVIFLY_EMAIL_USE_TLS=true
AVIFLY_DEFAULT_FROM_EMAIL=Avifly <no-reply@localhost>

# --- Public mode (behind Cloudflare Tunnel) -------------------------------------------------
AVIFLY_PUBLIC_MODE=false
# e.g. https://app.example.com  (also add app.example.com to AVIFLY_ALLOWED_HOSTS, and
# keep 127.0.0.1 there: local health checks call http://127.0.0.1:8000/healthz)
AVIFLY_CSRF_TRUSTED_ORIGINS=
# Cloudflare Access (optional): your team domain and the application's AUD tag
AVIFLY_CF_ACCESS_TEAM_DOMAIN=
AVIFLY_CF_ACCESS_AUD=
# Cloudflare Turnstile bot check on the sign-up form (optional)
AVIFLY_TURNSTILE_SITE_KEY=
AVIFLY_TURNSTILE_SECRET_KEY=
